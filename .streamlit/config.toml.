[theme]
base = "light"
primaryColor = "#008080"
backgroundColor = "#FFFFFF"
secondaryBackgroundColor = "#F2F9FB"
textColor = "#23284A"
linkColor = "#000080"
borderColor = "#D5E8EE"
showWidgetBorder = true
baseRadius = "0.6rem"
font = "Nunito:https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap"
headingFont = "Nunito:https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap"
headingFontWeights = [800, 700, 700]

[client]
toolbarMode = "viewer"

[server]
maxUploadSize = 20
